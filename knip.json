{
	"$schema": "https://unpkg.com/knip@latest/schema.json",
	"ignore": [
		"**/__tests__/**",
		"apps/vscode-e2e/**",
		"evals/**",
		"src/extension/api.ts",
		"src/activate/**",
		"src/workers/countTokens.ts",
		"src/extension.ts",
		"scripts/**",
		"apps/cli/scripts/**"
	],
	"workspaces": {
		"src": {
			"entry": ["extension.ts"],
			"project": ["**/*.ts"]
		},
		"webview-ui": {
			"entry": ["src/index.tsx"],
			"project": ["src/**/*.{ts,tsx}", "../src/shared/*.ts"]
		},
		"packages/evals": {
			"entry": ["src/certification/cli.ts", "src/evidence/cli.ts"],
			"project": ["src/**/*.ts"]
		},
		"packages/{build,cloud,ipc,telemetry,types}": {
			"project": ["src/**/*.ts"]
		}
	}
}

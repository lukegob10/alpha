# Only build inputs belong in the evaluator image. Local Alpha indexes,
# task history, service storage and run artifacts stay out.
**
!package.json
!pnpm-lock.yaml
!pnpm-workspace.yaml
!turbo.json
!.prettierrc.json
!README.md
!CHANGELOG.md
!LICENSE
!scripts/
!scripts/**
!packages/
!packages/build/
!packages/build/**
!packages/config-eslint/
!packages/config-eslint/**
!packages/config-typescript/
!packages/config-typescript/**
!packages/core/
!packages/core/**
!packages/evals/
!packages/evals/**
!packages/ipc/
!packages/ipc/**
!packages/telemetry/
!packages/telemetry/**
!packages/types/
!packages/types/**
!src/
!src/**
!webview-ui/
!webview-ui/**
!evals/
!evals/**

# Keep exclusions after directory exceptions so descendants remain excluded.
**/.git/
**/.vscode/
**/.alpha/
**/node_modules/
**/dist/
**/out/
**/.turbo/
**/.vscode-test/
**/artifacts/
**/coverage/
**/*.log
**/*.tmp
src/webview-ui/
evals/archive/
evals/reports/
packages/evals/.docker/postgres/
packages/evals/.docker/redis/
**/.env*
!packages/evals/.env.development
!packages/evals/.env.test

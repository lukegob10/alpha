branch="$(git rev-parse --abbrev-ref HEAD)"

if [ "$branch" = "main" ]; then
  echo "You can't commit directly to main - please check out a branch."
  exit 1
fi

# Prefer the shell launcher in Git hooks; Windows installs may also provide pnpm.cmd.
pnpm_cmd=pnpm
if ! command -v pnpm >/dev/null 2>&1; then
  pnpm_cmd=pnpm.cmd
fi

if ! command -v "$pnpm_cmd" >/dev/null 2>&1; then
  echo "pnpm@11.24.0 is required; install the repository toolchain before committing."
  exit 1
fi

$pnpm_cmd exec lint-staged
$pnpm_cmd lint

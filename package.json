{
	"name": "alpha",
	"packageManager": "pnpm@10.8.1",
	"engines": {
		"node": "20.19.2"
	},
	"scripts": {
		"preinstall": "node scripts/bootstrap.mjs",
		"prepare": "husky",
		"install": "node scripts/bootstrap.mjs",
		"install:all": "node scripts/bootstrap.mjs",
		"lint": "turbo lint --log-order grouped --output-logs new-only",
		"check-types": "turbo check-types --log-order grouped --output-logs new-only",
		"test": "pnpm bundle && turbo test --log-order grouped --output-logs new-only",
		"certify:managed-agents": "node scripts/certification/managed-agent-milestone-certify.mjs --strict --evidence artifacts/certification/managed-agent-milestone-evidence.json",
		"certify:managed-agents:list": "node scripts/certification/managed-agent-milestone-certify.mjs --list",
		"certify:managed-agents:self-check": "node scripts/certification/managed-agent-milestone-certify.mjs --self-check",
		"certify:managed-agents:host-e2e": "pnpm --filter @alpha-code/vscode-e2e test:managed-agents",
		"certify:managed-agents:automated": "pnpm certify:managed-agents && pnpm certify:managed-agents:host-e2e",
		"certify:managed-agents:live-preflight": "node scripts/certification/managed-agent-live-playbook-preflight.mjs",
		"certify:managed-agents:prepare-run-c": "node scripts/certification/managed-agent-live-playbook-preflight.mjs --prepare-run-c-workspace",
		"format": "turbo format --log-order grouped --output-logs new-only",
		"build": "turbo build --log-order grouped --output-logs new-only",
		"bundle": "turbo bundle --log-order grouped --output-logs new-only",
		"bundle:nightly": "turbo bundle:nightly --log-order grouped --output-logs new-only",
		"vsix": "turbo vsix --log-order grouped --output-logs new-only",
		"vsix:nightly": "turbo vsix:nightly --log-order grouped --output-logs new-only",
		"clean": "turbo clean --log-order grouped --output-logs new-only && rimraf dist out bin .vite-port .turbo",
		"install:vsix": "pnpm install --frozen-lockfile && pnpm clean && pnpm vsix && node scripts/install-vsix.js",
		"install:vsix:nightly": "pnpm install --frozen-lockfile && pnpm clean && pnpm vsix:nightly && node scripts/install-vsix.js --nightly",
		"evals:offline-certify": "dotenvx run -f packages/evals/.env.development packages/evals/.env.local -- node scripts/offline-certify.mjs",
		"evals:offline-certify:full": "dotenvx run -f packages/evals/.env.development packages/evals/.env.local -- node scripts/offline-certify.mjs --full",
		"code-server:install": "node scripts/code-server.js",
		"changeset:version": "cp CHANGELOG.md src/CHANGELOG.md && changeset version && cp -vf src/CHANGELOG.md .",
		"knip": "knip --include files",
		"evals": "dotenvx run -f packages/evals/.env.development packages/evals/.env.local -- docker compose -f packages/evals/docker-compose.yml --profile server --profile runner up --build --scale runner=0",
		"npm:publish:types": "pnpm --filter @alpha-code/types npm:publish"
	},
	"devDependencies": {
		"@changesets/cli": "^2.27.10",
		"@dotenvx/dotenvx": "^1.34.0",
		"@alpha-code/config-typescript": "workspace:^",
		"@types/glob": "^9.0.0",
		"@types/node": "^24.1.0",
		"@vscode/vsce": "3.3.2",
		"esbuild": "^0.25.0",
		"eslint": "^9.27.0",
		"glob": "^11.1.0",
		"husky": "^9.1.7",
		"knip": "^5.44.4",
		"lint-staged": "^16.0.0",
		"mkdirp": "^3.0.1",
		"only-allow": "^1.2.1",
		"ovsx": "0.10.4",
		"prettier": "^3.4.2",
		"rimraf": "^6.0.1",
		"tsx": "^4.22.0",
		"turbo": "^2.5.6",
		"typescript": "5.8.3"
	},
	"lint-staged": {
		"*.{js,jsx,ts,tsx,json,css,md}": [
			"prettier --write"
		]
	},
	"pnpm": {
		"onlyBuiltDependencies": [
			"@vscode/ripgrep"
		],
		"overrides": {
			"tar-fs": ">=3.1.1",
			"tar": "7.5.22",
			"esbuild": ">=0.25.0",
			"undici": ">=5.29.0",
			"basic-ftp": "5.3.1",
			"fast-xml-parser": "5.5.6",
			"shell-quote": "1.9.0",
			"simple-git": "3.36.0",
			"brace-expansion": "2.1.4",
			"form-data": "4.0.6",
			"bluebird": ">=3.7.2",
			"glob": ">=11.1.0",
			"@types/react": "^18.3.23",
			"@types/react-dom": "^18.3.5",
			"zod": "3.25.76"
		}
	}
}

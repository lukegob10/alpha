{
	"name": "@alpha-code/evals",
	"description": "Alpha evals.",
	"version": "0.0.1",
	"type": "module",
	"exports": "./src/index.ts",
	"scripts": {
		"lint": "eslint src --ext=ts --max-warnings=0",
		"check-types": "tsc --noEmit",
		"benchmark:run-model": "dotenvx run -f .env.development .env.local -- tsx src/benchmark/cli.ts run-model",
		"benchmark:validate": "tsx src/benchmark/cli.ts validate",
		"benchmark:author-check": "tsx src/benchmark/cli.ts author-check",
		"benchmark:template": "tsx src/benchmark/cli.ts template",
		"benchmark:subset": "tsx src/benchmark/cli.ts subset",
		"benchmark:history-update": "dotenvx run -f .env.development .env.local -- tsx src/benchmark/cli.ts history-update",
		"benchmark:sync-keyless": "dotenvx run -f .env.development .env.local -- tsx src/benchmark/cli.ts sync-keyless",
		"benchmark:release-audit": "dotenvx run -f .env.development .env.local -- tsx src/benchmark/cli.ts release-audit",
		"benchmark:review-sample": "dotenvx run -f .env.development .env.local -- tsx src/benchmark/cli.ts review-sample",
		"benchmark:paired-report": "dotenvx run -f .env.development .env.local -- tsx src/benchmark/cli.ts paired-report",
		"benchmark:estimate": "tsx src/benchmark/cli.ts estimate",
		"benchmark:fixture-check": "tsx src/benchmark/cli.ts fixture-check",
		"_test": "dotenvx run -f .env.test -- vitest run",
		"test:unit": "dotenvx run -f .env.test -- vitest run --config vitest.unit.config.ts",
		"test:integration": "dotenvx run -f .env.test -- vitest run --config vitest.integration.config.ts",
		"test:contract": "dotenvx run -f .env.test -- vitest run --config vitest.contract.config.ts",
		"test:certification": "dotenvx run -f .env.test -- vitest run --config vitest.certification.config.ts",
		"test:infrastructure": "dotenvx run -f .env.test -- vitest run --config vitest.infrastructure.config.ts",
		"test:all": "pnpm test:unit && pnpm test:integration && pnpm test:contract && pnpm test:certification && pnpm test:infrastructure",
		"clean": "rimraf dist .turbo",
		"cli": "dotenvx run -f .env.development .env.local -- tsx src/cli/index.ts",
		"drizzle-kit": "dotenvx run -f .env.development -- tsx node_modules/drizzle-kit/bin.cjs",
		"drizzle-kit:test": "dotenvx run -f .env.test -- tsx node_modules/drizzle-kit/bin.cjs",
		"drizzle-kit:production": "dotenvx run -f .env.production -- tsx node_modules/drizzle-kit/bin.cjs",
		"db:generate": "pnpm drizzle-kit generate",
		"db:migrate": "pnpm drizzle-kit migrate",
		"db:test:migrate": "pnpm drizzle-kit:test migrate",
		"db:production:migrate": "pnpm drizzle-kit:production migrate",
		"db:push": "pnpm drizzle-kit push",
		"db:test:push": "pnpm drizzle-kit:test push",
		"db:production:push": "pnpm drizzle-kit:production push",
		"db:up": "dotenvx run -f .env.development .env.local -- docker compose up -d db",
		"db:down": "dotenvx run -f .env.development .env.local -- docker compose down db",
		"redis:up": "dotenvx run -f .env.development .env.local -- docker compose up -d redis",
		"redis:down": "dotenvx run -f .env.development .env.local -- docker compose down redis",
		"services:up": "dotenvx run -f .env.development .env.local -- docker compose up -d db redis",
		"services:down": "dotenvx run -f .env.development .env.local -- docker compose down db redis"
	},
	"dependencies": {
		"@alpha-code/ipc": "workspace:^",
		"@alpha-code/types": "workspace:^",
		"cmd-ts": "^0.13.0",
		"drizzle-orm": "^0.44.1",
		"execa": "^9.6.0",
		"node-ipc": "^12.0.0",
		"p-map": "^7.0.3",
		"p-queue": "^8.1.0",
		"p-wait-for": "^5.0.2",
		"postgres": "^3.4.7",
		"ps-tree": "^1.2.0",
		"redis": "^5.5.5",
		"yaml": "2.8.1",
		"zod": "^3.25.61"
	},
	"devDependencies": {
		"@alpha-code/config-eslint": "workspace:^",
		"@alpha-code/config-typescript": "workspace:^",
		"@types/node": "20.x",
		"@types/node-ipc": "^9.2.3",
		"@types/ps-tree": "^1.1.6",
		"drizzle-kit": "^0.31.1",
		"tsx": "^4.22.0",
		"vitest": "^3.2.3"
	}
}

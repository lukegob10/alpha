{
	"version": 1,
	"id": "final-m0-m7-harness-audit",
	"target": "docs/testing-harness-convergence-milestones.md",
	"suite": "evals/certification/suite.json",
	"artifactRoot": ".frontier-campaign/campaigns",
	"budgets": {
		"maxCampaignWallMs": 1200000,
		"maxCommandWallMs": 360000,
		"maxCommands": 9,
		"maxOutputBytesPerCommand": 1048576
	},
	"allowedCommandPrefixes": [
		["pnpm", "--filter", "@alpha-code/evals", "test:all"],
		["pnpm", "--filter", "@alpha-code/evals", "test:infrastructure"],
		["pnpm", "--filter", "@alpha-code/evals", "test:certification"],
		["pnpm", "--filter", "@alpha-code/evals", "test:experiments"],
		["pnpm", "--filter", "@alpha-code/evals", "test:coverage"],
		["pnpm", "--filter", "@alpha-code/evals", "check-types"],
		["pnpm", "--filter", "@alpha-code/evals", "lint"],
		["pnpm", "--filter", "@alpha-code/web-evals", "test"],
		["pnpm", "--filter", "@alpha-code/web-evals", "check-types"]
	],
	"validationCommands": [
		{ "id": "eval-all", "command": "pnpm", "args": ["--filter", "@alpha-code/evals", "test:all"], "cwd": "." },
		{
			"id": "infrastructure",
			"command": "pnpm",
			"args": ["--filter", "@alpha-code/evals", "test:infrastructure"],
			"cwd": "."
		},
		{
			"id": "certification",
			"command": "pnpm",
			"args": ["--filter", "@alpha-code/evals", "test:certification"],
			"cwd": "."
		},
		{
			"id": "experiments",
			"command": "pnpm",
			"args": ["--filter", "@alpha-code/evals", "test:experiments"],
			"cwd": "."
		},
		{ "id": "coverage", "command": "pnpm", "args": ["--filter", "@alpha-code/evals", "test:coverage"], "cwd": "." },
		{ "id": "types", "command": "pnpm", "args": ["--filter", "@alpha-code/evals", "check-types"], "cwd": "." },
		{ "id": "lint", "command": "pnpm", "args": ["--filter", "@alpha-code/evals", "lint"], "cwd": "." },
		{ "id": "web-tests", "command": "pnpm", "args": ["--filter", "@alpha-code/web-evals", "test"], "cwd": "." },
		{
			"id": "web-types",
			"command": "pnpm",
			"args": ["--filter", "@alpha-code/web-evals", "check-types"],
			"cwd": "."
		}
	],
	"model": { "enabled": false }
}

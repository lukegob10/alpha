{
	"name": "alpha",
	"displayName": "%extension.displayName%",
	"description": "%extension.description%",
	"publisher": "AlphaInc",
	"version": "3.0.1",
	"icon": "assets/icons/icon.png",
	"galleryBanner": {
		"color": "#617A91",
		"theme": "dark"
	},
	"engines": {
		"vscode": "^1.122.1",
		"node": "24.14.1"
	},
	"author": {
		"name": "Alpha"
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/AlphaInc/Alpha"
	},
	"homepage": "https://github.com/AlphaInc/Alpha",
	"categories": [
		"AI",
		"Chat",
		"Programming Languages",
		"Education",
		"Snippets",
		"Testing"
	],
	"keywords": [
		"alpha",
		"dev",
		"mcp",
		"coding",
		"agent",
		"autonomous",
		"chatgpt",
		"sonnet",
		"ai",
		"llama",
		"alpha code",
		"alpha"
	],
	"activationEvents": [
		"onWebviewPanel:alpha.htmlDocument",
		"onWebviewPanel:alpha.tickets",
		"onLanguage",
		"onStartupFinished"
	],
	"main": "./dist/extension.js",
	"contributes": {
		"viewsContainers": {
			"activitybar": [
				{
					"id": "alpha-ActivityBar",
					"title": "%views.activitybar.title%",
					"icon": "assets/icons/icon.svg"
				}
			]
		},
		"views": {
			"alpha-ActivityBar": [
				{
					"type": "webview",
					"id": "alpha.SidebarProvider",
					"name": "%views.sidebar.name%"
				}
			]
		},
		"commands": [
			{
				"command": "alpha.previewHtmlDocument",
				"title": "%command.previewHtmlDocument.title%",
				"category": "Alpha"
			},
			{
				"command": "alpha.openTickets",
				"title": "%command.openTickets.title%",
				"icon": "$(issues)"
			},
			{
				"command": "alpha.plusButtonClicked",
				"title": "%command.newTask.title%",
				"icon": "$(edit)"
			},
			{
				"command": "alpha.historyButtonClicked",
				"title": "%command.history.title%",
				"icon": "$(history)"
			},
			{
				"command": "alpha.scheduledTasksButtonClicked",
				"title": "%command.scheduledTasks.title%",
				"icon": "$(calendar)"
			},
			{
				"command": "alpha.marketplaceButtonClicked",
				"title": "%command.marketplace.title%",
				"icon": "$(extensions)"
			},
			{
				"command": "alpha.popoutButtonClicked",
				"title": "%command.openInEditor.title%",
				"icon": "$(link-external)"
			},
			{
				"command": "alpha.settingsButtonClicked",
				"title": "%command.settings.title%",
				"icon": "$(settings-gear)"
			},
			{
				"command": "alpha.openInNewTab",
				"title": "%command.openInNewTab.title%",
				"category": "%configuration.title%"
			},
			{
				"command": "alpha.explainCode",
				"title": "%command.explainCode.title%",
				"category": "%configuration.title%"
			},
			{
				"command": "alpha.fixCode",
				"title": "%command.fixCode.title%",
				"category": "%configuration.title%"
			},
			{
				"command": "alpha.improveCode",
				"title": "%command.improveCode.title%",
				"category": "%configuration.title%"
			},
			{
				"command": "alpha.addToContext",
				"title": "%command.addToContext.title%",
				"category": "%configuration.title%"
			},
			{
				"command": "alpha.newTask",
				"title": "%command.newTask.title%",
				"category": "%configuration.title%"
			},
			{
				"command": "alpha.terminalAddToContext",
				"title": "%command.terminal.addToContext.title%",
				"category": "Terminal"
			},
			{
				"command": "alpha.terminalFixCommand",
				"title": "%command.terminal.fixCommand.title%",
				"category": "Terminal"
			},
			{
				"command": "alpha.terminalExplainCommand",
				"title": "%command.terminal.explainCommand.title%",
				"category": "Terminal"
			},
			{
				"command": "alpha.setCustomStoragePath",
				"title": "%command.setCustomStoragePath.title%",
				"category": "%configuration.title%"
			},
			{
				"command": "alpha.importSettings",
				"title": "%command.importSettings.title%",
				"category": "%configuration.title%"
			},
			{
				"command": "alpha.focusInput",
				"title": "%command.focusInput.title%",
				"category": "%configuration.title%"
			},
			{
				"command": "alpha.acceptInput",
				"title": "%command.acceptInput.title%",
				"category": "%configuration.title%"
			},
			{
				"command": "alpha.toggleAutoApprove",
				"title": "%command.toggleAutoApprove.title%",
				"category": "%configuration.title%"
			}
		],
		"menus": {
			"explorer/context": [
				{
					"command": "alpha.previewHtmlDocument",
					"group": "navigation@10",
					"when": "!explorerResourceIsFolder && resourceScheme == file && resourceExtname =~ /^\\.html?$/i"
				}
			],
			"editor/context": [
				{
					"submenu": "alpha.contextMenu",
					"group": "1"
				}
			],
			"alpha.contextMenu": [
				{
					"command": "alpha.addToContext",
					"group": "1_actions@1"
				},
				{
					"command": "alpha.explainCode",
					"group": "1_actions@2"
				},
				{
					"command": "alpha.improveCode",
					"group": "1_actions@3"
				}
			],
			"terminal/context": [
				{
					"submenu": "alpha.terminalMenu",
					"group": "2"
				}
			],
			"alpha.terminalMenu": [
				{
					"command": "alpha.terminalAddToContext",
					"group": "1_actions@1"
				},
				{
					"command": "alpha.terminalFixCommand",
					"group": "1_actions@2"
				},
				{
					"command": "alpha.terminalExplainCommand",
					"group": "1_actions@3"
				}
			],
			"view/title": [
				{
					"command": "alpha.plusButtonClicked",
					"group": "navigation@1",
					"when": "view == alpha.SidebarProvider"
				},
				{
					"command": "alpha.settingsButtonClicked",
					"group": "navigation@2",
					"when": "view == alpha.SidebarProvider"
				},
				{
					"command": "alpha.openTickets",
					"group": "navigation@3",
					"when": "view == alpha.SidebarProvider"
				},
				{
					"command": "alpha.historyButtonClicked",
					"group": "overflow@1",
					"when": "view == alpha.SidebarProvider"
				},
				{
					"command": "alpha.scheduledTasksButtonClicked",
					"group": "overflow@2",
					"when": "view == alpha.SidebarProvider"
				},
				{
					"command": "alpha.marketplaceButtonClicked",
					"group": "overflow@3",
					"when": "view == alpha.SidebarProvider"
				},
				{
					"command": "alpha.popoutButtonClicked",
					"group": "overflow@4",
					"when": "view == alpha.SidebarProvider"
				}
			],
			"editor/title": [
				{
					"command": "alpha.plusButtonClicked",
					"group": "navigation@1",
					"when": "activeWebviewPanelId == alpha.TabPanelProvider"
				},
				{
					"command": "alpha.settingsButtonClicked",
					"group": "navigation@2",
					"when": "activeWebviewPanelId == alpha.TabPanelProvider"
				},
				{
					"command": "alpha.openTickets",
					"group": "navigation@3",
					"when": "activeWebviewPanelId == alpha.TabPanelProvider"
				},
				{
					"command": "alpha.historyButtonClicked",
					"group": "overflow@1",
					"when": "activeWebviewPanelId == alpha.TabPanelProvider"
				},
				{
					"command": "alpha.scheduledTasksButtonClicked",
					"group": "overflow@2",
					"when": "activeWebviewPanelId == alpha.TabPanelProvider"
				},
				{
					"command": "alpha.marketplaceButtonClicked",
					"group": "overflow@3",
					"when": "activeWebviewPanelId == alpha.TabPanelProvider"
				},
				{
					"command": "alpha.popoutButtonClicked",
					"group": "overflow@4",
					"when": "activeWebviewPanelId == alpha.TabPanelProvider"
				}
			]
		},
		"keybindings": [
			{
				"command": "alpha.addToContext",
				"key": "cmd+k cmd+a",
				"mac": "cmd+k cmd+a",
				"win": "ctrl+k ctrl+a",
				"linux": "ctrl+k ctrl+a",
				"when": "editorTextFocus && editorHasSelection"
			},
			{
				"command": "alpha.toggleAutoApprove",
				"key": "cmd+alt+a",
				"mac": "cmd+alt+a",
				"win": "ctrl+alt+a",
				"linux": "ctrl+alt+a"
			}
		],
		"submenus": [
			{
				"id": "alpha.contextMenu",
				"label": "%views.contextMenu.label%"
			},
			{
				"id": "alpha.terminalMenu",
				"label": "%views.terminalMenu.label%"
			}
		],
		"configuration": {
			"title": "%configuration.title%",
			"properties": {
				"alpha.allowedCommands": {
					"type": "array",
					"items": {
						"type": "string"
					},
					"default": [
						"git log",
						"git diff",
						"git show"
					],
					"description": "%commands.allowedCommands.description%"
				},
				"alpha.deniedCommands": {
					"type": "array",
					"items": {
						"type": "string"
					},
					"default": [],
					"description": "%commands.deniedCommands.description%"
				},
				"alpha.commandExecutionTimeout": {
					"type": "number",
					"default": 0,
					"minimum": 0,
					"maximum": 600,
					"description": "%commands.commandExecutionTimeout.description%"
				},
				"alpha.commandTimeoutAllowlist": {
					"type": "array",
					"items": {
						"type": "string"
					},
					"default": [],
					"description": "%commands.commandTimeoutAllowlist.description%"
				},
				"alpha.preventCompletionWithOpenTodos": {
					"type": "boolean",
					"default": false,
					"description": "%commands.preventCompletionWithOpenTodos.description%"
				},
				"alpha.vsCodeLmModelSelector": {
					"type": "object",
					"properties": {
						"vendor": {
							"type": "string",
							"description": "%settings.vsCodeLmModelSelector.vendor.description%"
						},
						"family": {
							"type": "string",
							"description": "%settings.vsCodeLmModelSelector.family.description%"
						},
						"version": {
							"type": "string",
							"description": "%settings.vsCodeLmModelSelector.version.description%"
						},
						"id": {
							"type": "string",
							"description": "%settings.vsCodeLmModelSelector.id.description%"
						}
					},
					"description": "%settings.vsCodeLmModelSelector.description%"
				},
				"alpha.customStoragePath": {
					"type": "string",
					"default": "",
					"description": "%settings.customStoragePath.description%"
				},
				"alpha.enableCodeActions": {
					"type": "boolean",
					"default": true,
					"description": "%settings.enableCodeActions.description%"
				},
				"alpha.autoImportSettingsPath": {
					"type": "string",
					"default": "",
					"description": "%settings.autoImportSettingsPath.description%"
				},
				"alpha.maximumIndexedFilesForFileSearch": {
					"type": "number",
					"default": 10000,
					"minimum": 5000,
					"maximum": 500000,
					"description": "%settings.maximumIndexedFilesForFileSearch.description%"
				},
				"alpha.useAgentRules": {
					"type": "boolean",
					"default": true,
					"description": "%settings.useAgentRules.description%"
				},
				"alpha.apiRequestTimeout": {
					"type": "number",
					"default": 600,
					"minimum": 0,
					"maximum": 3600,
					"description": "%settings.apiRequestTimeout.description%"
				},
				"alpha.newTaskRequireTodos": {
					"type": "boolean",
					"default": false,
					"description": "%settings.newTaskRequireTodos.description%"
				},
				"alpha.codeIndex.embeddingBatchSize": {
					"type": "number",
					"default": 60,
					"minimum": 1,
					"maximum": 200,
					"description": "%settings.codeIndex.embeddingBatchSize.description%"
				},
				"alpha.debug": {
					"type": "boolean",
					"default": false,
					"description": "%settings.debug.description%"
				},
				"alpha.debugProxy.enabled": {
					"type": "boolean",
					"default": false,
					"description": "%settings.debugProxy.enabled.description%",
					"markdownDescription": "%settings.debugProxy.enabled.description%"
				},
				"alpha.debugProxy.serverUrl": {
					"type": "string",
					"default": "http://127.0.0.1:8888",
					"description": "%settings.debugProxy.serverUrl.description%",
					"markdownDescription": "%settings.debugProxy.serverUrl.description%"
				},
				"alpha.debugProxy.tlsInsecure": {
					"type": "boolean",
					"default": false,
					"description": "%settings.debugProxy.tlsInsecure.description%",
					"markdownDescription": "%settings.debugProxy.tlsInsecure.description%"
				}
			}
		}
	},
	"scripts": {
		"lint": "eslint . --ext=ts --max-warnings=0",
		"check-types": "tsc --noEmit",
		"test": "vitest run",
		"format": "prettier --write .",
		"bundle": "node esbuild.mjs",
		"vscode:prepublish": "pnpm bundle --production",
		"vsix": "mkdirp ../bin && vsce package --no-dependencies --out ../bin",
		"publish:marketplace": "vsce publish --no-dependencies && ovsx publish --no-dependencies",
		"watch:bundle": "pnpm bundle --watch",
		"watch:tsc": "node ../node_modules/typescript/lib/tsc.js --noEmit --watch --project tsconfig.dev-watch.json",
		"clean": "rimraf README.md CHANGELOG.md LICENSE dist logs mock .turbo"
	},
	"dependencies": {
		"@anthropic-ai/sdk": "^0.37.0",
		"@anthropic-ai/vertex-sdk": "^0.7.0",
		"@google/genai": "^1.47.0",
		"@lancedb/lancedb": "^0.27.2",
		"@modelcontextprotocol/sdk": "1.12.0",
		"@qdrant/js-client-rest": "^1.14.0",
		"@alpha-code/core": "workspace:^",
		"@alpha-code/ipc": "workspace:^",
		"@alpha-code/telemetry": "workspace:^",
		"@alpha-code/types": "workspace:^",
		"@vscode/ripgrep": "^1.17.0",
		"async-mutex": "^0.5.0",
		"axios": "^1.12.0",
		"cheerio": "^1.0.0",
		"chokidar": "^4.0.1",
		"clone-deep": "^4.0.1",
		"delay": "^6.0.0",
		"diff": "^5.2.0",
		"exceljs": "^4.4.0",
		"fast-deep-equal": "^3.1.3",
		"fastest-levenshtein": "^1.0.16",
		"fzf": "^0.5.2",
		"get-folder-size": "^5.0.0",
		"global-agent": "^3.0.0",
		"google-auth-library": "^9.15.1",
		"gray-matter": "^4.0.3",
		"i18next": "^25.0.0",
		"ignore": "^7.0.3",
		"isbinaryfile": "^5.0.2",
		"json-stream-stringify": "^3.1.6",
		"lodash.debounce": "^4.0.8",
		"mammoth": "^1.9.1",
		"monaco-vscode-textmate-theme-converter": "^0.1.7",
		"node-cache": "^5.1.2",
		"openai": "^5.12.2",
		"os-name": "^6.0.0",
		"p-limit": "^6.2.0",
		"p-wait-for": "^5.0.2",
		"partial-json": "^0.1.7",
		"pdf-parse": "^1.1.1",
		"pretty-bytes": "^7.0.0",
		"proper-lockfile": "^4.1.2",
		"ps-tree": "^1.2.0",
		"reconnecting-eventsource": "^1.6.4",
		"safe-stable-stringify": "^2.5.0",
		"say": "^0.16.0",
		"serialize-error": "^12.0.0",
		"shell-quote": "^1.8.2",
		"simple-git": "^3.27.0",
		"strip-bom": "^5.0.0",
		"tiktoken": "^1.0.21",
		"tree-sitter-wasms": "^0.1.12",
		"undici": "^6.21.3",
		"uuid": "^11.1.0",
		"vscode-material-icons": "^0.1.1",
		"web-tree-sitter": "^0.25.6",
		"workerpool": "^9.2.0",
		"yaml": "^2.8.0",
		"zod": "3.25.76"
	},
	"devDependencies": {
		"@alpha-code/build": "workspace:^",
		"@alpha-code/config-eslint": "workspace:^",
		"@types/clone-deep": "^4.0.4",
		"@types/debug": "^4.1.12",
		"@types/diff": "^5.2.1",
		"@types/lodash.debounce": "^4.0.9",
		"@types/node": "20.x",
		"@types/proper-lockfile": "^4.1.4",
		"@types/ps-tree": "^1.1.6",
		"@types/vscode": "^1.120.0",
		"@vscode/vsce": "3.3.2",
		"esbuild-wasm": "^0.25.0",
		"execa": "^9.5.2",
		"mkdirp": "^3.0.1",
		"nock": "^14.0.4",
		"ovsx": "0.10.4",
		"rimraf": "^6.0.1",
		"tsx": "^4.22.0",
		"vitest": "^3.2.3"
	}
}

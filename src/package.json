{
	"name": "alpha",
	"displayName": "%extension.displayName%",
	"description": "%extension.description%",
	"publisher": "AlphaInc",
	"version": "3.2.27",
	"icon": "assets/icons/icon.png",
	"galleryBanner": {
		"color": "#617A91",
		"theme": "dark"
	},
	"engines": {
		"vscode": "^1.125.0",
		"node": "24.21.0"
	},
	"author": {
		"name": "Alpha"
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/lukegob10/alpha"
	},
	"homepage": "https://github.com/lukegob10/alpha",
	"categories": [
		"AI",
		"Chat",
		"Programming Languages",
		"Education",
		"Snippets",
		"Testing"
	],
	"keywords": [
		"alpha",
		"dev",
		"mcp",
		"coding",
		"agent",
		"autonomous",
		"chatgpt",
		"sonnet",
		"ai",
		"llama",
		"alpha code",
		"alpha"
	],
	"activationEvents": [
		"onWebviewPanel:alpha.TabPanelProvider",
		"onWebviewPanel:alpha.htmlDocument",
		"onWebviewPanel:alpha.tickets",
		"onWebviewPanel:alpha.incidents",
		"onLanguage",
		"onStartupFinished"
	],
	"main": "./dist/extension.js",
	"contributes": {
		"viewsContainers": {
			"activitybar": [
				{
					"id": "alpha-ActivityBar",
					"title": "%views.activitybar.title%",
					"icon": "assets/icons/icon.svg"
				}
			]
		},
		"views": {
			"alpha-ActivityBar": [
				{
					"type": "webview",
					"id": "alpha.SidebarProvider",
					"name": "%views.sidebar.name%"
				}
			]
		},
		"commands": [
			{
				"command": "alpha.diagramZoomOut",
				"title": "%command.diagramZoomOut.title%",
				"category": "%configuration.title%",
				"icon": "$(zoom-out)",
				"enablement": "activeCustomEditorId == 'imagePreview.previewEditor' && resourceExtname == '.svg'"
			},
			{
				"command": "alpha.diagramZoomIn",
				"title": "%command.diagramZoomIn.title%",
				"category": "%configuration.title%",
				"icon": "$(zoom-in)",
				"enablement": "activeCustomEditorId == 'imagePreview.previewEditor' && resourceExtname == '.svg'"
			},
			{
				"command": "alpha.diffReviewActions",
				"title": "%command.diffReviewActions.title%",
				"category": "%configuration.title%",
				"icon": "$(list-selection)",
				"enablement": "activeEditor == multiDiffEditor"
			},
			{
				"command": "alpha.sidebarNewChat",
				"title": "%command.newTask.title%",
				"icon": {
					"light": "assets/icons/chat-actions/new-chat-light.svg",
					"dark": "assets/icons/chat-actions/new-chat-dark.svg"
				}
			},
			{
				"command": "alpha.sidebarSettings",
				"title": "%command.settings.title%",
				"icon": {
					"light": "assets/icons/chat-actions/settings-light.svg",
					"dark": "assets/icons/chat-actions/settings-dark.svg"
				}
			},
			{
				"command": "alpha.sidebarScheduledTasks",
				"title": "%command.scheduledTasks.title%",
				"icon": "$(calendar)"
			},
			{
				"command": "alpha.manageGoal",
				"title": "%command.manageGoal.title%",
				"category": "%configuration.title%"
			},
			{
				"command": "alpha.previewHtmlDocument",
				"title": "%command.previewHtmlDocument.title%",
				"category": "Alpha"
			},
			{
				"command": "alpha.openTickets",
				"title": "%command.openTickets.title%",
				"icon": {
					"light": "assets/icons/chat-actions/tickets-light.svg",
					"dark": "assets/icons/chat-actions/tickets-dark.svg"
				}
			},
			{
				"command": "alpha.openIncidents",
				"title": "%command.openIncidents.title%",
				"icon": "$(pulse)"
			},
			{
				"command": "alpha.exportDiagnostics",
				"title": "%command.exportDiagnostics.title%"
			},
			{
				"command": "alpha.recoverTaskHistory",
				"title": "%command.recoverTaskHistory.title%"
			},
			{
				"command": "alpha.plusButtonClicked",
				"title": "%command.newTask.title%",
				"icon": {
					"light": "assets/icons/chat-actions/new-chat-light.svg",
					"dark": "assets/icons/chat-actions/new-chat-dark.svg"
				}
			},
			{
				"command": "alpha.historyButtonClicked",
				"title": "%command.history.title%",
				"icon": "$(history)"
			},
			{
				"command": "alpha.scheduledTasksButtonClicked",
				"title": "%command.scheduledTasks.title%",
				"icon": "$(calendar)"
			},
			{
				"command": "alpha.popoutButtonClicked",
				"title": "%command.openInEditor.title%",
				"icon": "$(link-external)"
			},
			{
				"command": "alpha.settingsButtonClicked",
				"title": "%command.settings.title%",
				"icon": {
					"light": "assets/icons/chat-actions/settings-light.svg",
					"dark": "assets/icons/chat-actions/settings-dark.svg"
				}
			},
			{
				"command": "alpha.openInNewTab",
				"title": "%command.openInNewTab.title%",
				"category": "%configuration.title%"
			},
			{
				"command": "alpha.newTask",
				"title": "%command.newTask.title%",
				"category": "%configuration.title%"
			},
			{
				"command": "alpha.setCustomStoragePath",
				"title": "%command.setCustomStoragePath.title%",
				"category": "%configuration.title%"
			},
			{
				"command": "alpha.importSettings",
				"title": "%command.importSettings.title%",
				"category": "%configuration.title%"
			},
			{
				"command": "alpha.focusInput",
				"title": "%command.focusInput.title%",
				"category": "%configuration.title%"
			},
			{
				"command": "alpha.acceptInput",
				"title": "%command.acceptInput.title%",
				"category": "%configuration.title%"
			},
			{
				"command": "alpha.sendAndSteer",
				"title": "%command.sendAndSteer.title%",
				"category": "%configuration.title%"
			},
			{
				"command": "alpha.decreaseReasoningEffort",
				"title": "%command.decreaseReasoningEffort.title%",
				"category": "%configuration.title%"
			},
			{
				"command": "alpha.increaseReasoningEffort",
				"title": "%command.increaseReasoningEffort.title%",
				"category": "%configuration.title%"
			},
			{
				"command": "alpha.previousTask",
				"title": "%command.previousTask.title%",
				"category": "%configuration.title%"
			},
			{
				"command": "alpha.nextTask",
				"title": "%command.nextTask.title%",
				"category": "%configuration.title%"
			},
			{
				"command": "alpha.nextTaskNeedingInput",
				"title": "%command.nextTaskNeedingInput.title%",
				"category": "%configuration.title%"
			},
			{
				"command": "alpha.toggleAutoApprove",
				"title": "%command.toggleAutoApprove.title%",
				"category": "%configuration.title%"
			}
		],
		"menus": {
			"commandPalette": [
				{
					"command": "alpha.diagramZoomOut",
					"when": "activeCustomEditorId == 'imagePreview.previewEditor' && resourceExtname == '.svg'"
				},
				{
					"command": "alpha.diagramZoomIn",
					"when": "activeCustomEditorId == 'imagePreview.previewEditor' && resourceExtname == '.svg'"
				},
				{
					"command": "alpha.sidebarNewChat",
					"when": "false"
				},
				{
					"command": "alpha.sidebarSettings",
					"when": "false"
				},
				{
					"command": "alpha.sidebarScheduledTasks",
					"when": "false"
				},
				{
					"command": "alpha.openIncidents",
					"when": "config.alpha.debug"
				}
			],
			"explorer/context": [
				{
					"command": "alpha.previewHtmlDocument",
					"group": "navigation@10",
					"when": "!explorerResourceIsFolder && resourceScheme == file && resourceExtname =~ /^\\.html?$/i"
				}
			],
			"view/title": [
				{
					"command": "alpha.sidebarNewChat",
					"group": "navigation@1",
					"when": "view == alpha.SidebarProvider"
				},
				{
					"command": "alpha.sidebarSettings",
					"group": "navigation@2",
					"when": "view == alpha.SidebarProvider"
				},
				{
					"command": "alpha.openTickets",
					"group": "navigation@3",
					"when": "view == alpha.SidebarProvider"
				},
				{
					"command": "alpha.openIncidents",
					"group": "overflow@0",
					"when": "view == alpha.SidebarProvider && config.alpha.debug"
				},
				{
					"command": "alpha.sidebarScheduledTasks",
					"group": "overflow@1",
					"when": "view == alpha.SidebarProvider"
				}
			],
			"editor/title": [
				{
					"command": "alpha.diagramZoomOut",
					"when": "activeCustomEditorId == 'imagePreview.previewEditor' && resourceExtname == '.svg'",
					"group": "navigation@1"
				},
				{
					"command": "alpha.diagramZoomIn",
					"when": "activeCustomEditorId == 'imagePreview.previewEditor' && resourceExtname == '.svg'",
					"group": "navigation@2"
				},
				{
					"command": "alpha.diffReviewActions",
					"when": "activeEditor == multiDiffEditor",
					"group": "navigation@90"
				}
			]
		},
		"keybindings": [
			{
				"command": "multiDiffEditor.collapseAll",
				"key": "ctrl+alt+0",
				"mac": "cmd+alt+0",
				"when": "activeEditor == multiDiffEditor"
			},
			{
				"command": "multiDiffEditor.expandAll",
				"key": "ctrl+alt+9",
				"mac": "cmd+alt+9",
				"when": "activeEditor == multiDiffEditor"
			},
			{
				"command": "alpha.plusButtonClicked",
				"key": "ctrl+alt+n",
				"when": "isWindows && alpha.focusedWebview != sidebar && focusedView != alpha.SidebarProvider"
			},
			{
				"command": "alpha.plusButtonClicked",
				"key": "ctrl+alt+n",
				"when": "isWindows && (alpha.focusedWebview == sidebar || focusedView == alpha.SidebarProvider)",
				"args": "sidebar"
			},
			{
				"command": "alpha.sendAndSteer",
				"key": "ctrl+alt+s",
				"when": "isWindows && alpha.focusedWebview == editor"
			},
			{
				"command": "alpha.sendAndSteer",
				"key": "ctrl+alt+s",
				"when": "isWindows && (alpha.focusedWebview == sidebar || focusedView == alpha.SidebarProvider)",
				"args": "sidebar"
			},
			{
				"command": "alpha.decreaseReasoningEffort",
				"key": "alt+,",
				"when": "isWindows && alpha.focusedWebview == editor"
			},
			{
				"command": "alpha.decreaseReasoningEffort",
				"key": "alt+,",
				"when": "isWindows && (alpha.focusedWebview == sidebar || focusedView == alpha.SidebarProvider)",
				"args": "sidebar"
			},
			{
				"command": "alpha.increaseReasoningEffort",
				"key": "alt+.",
				"when": "isWindows && alpha.focusedWebview == editor"
			},
			{
				"command": "alpha.increaseReasoningEffort",
				"key": "alt+.",
				"when": "isWindows && (alpha.focusedWebview == sidebar || focusedView == alpha.SidebarProvider)",
				"args": "sidebar"
			},
			{
				"command": "alpha.previousTask",
				"key": "ctrl+alt+pageup",
				"when": "isWindows && alpha.focusedWebview == editor"
			},
			{
				"command": "alpha.previousTask",
				"key": "ctrl+alt+pageup",
				"when": "isWindows && (alpha.focusedWebview == sidebar || focusedView == alpha.SidebarProvider)",
				"args": "sidebar"
			},
			{
				"command": "alpha.nextTask",
				"key": "ctrl+alt+pagedown",
				"when": "isWindows && alpha.focusedWebview == editor"
			},
			{
				"command": "alpha.nextTask",
				"key": "ctrl+alt+pagedown",
				"when": "isWindows && (alpha.focusedWebview == sidebar || focusedView == alpha.SidebarProvider)",
				"args": "sidebar"
			},
			{
				"command": "alpha.nextTaskNeedingInput",
				"key": "ctrl+alt+home",
				"when": "isWindows && alpha.focusedWebview == editor"
			},
			{
				"command": "alpha.nextTaskNeedingInput",
				"key": "ctrl+alt+home",
				"when": "isWindows && (alpha.focusedWebview == sidebar || focusedView == alpha.SidebarProvider)",
				"args": "sidebar"
			},
			{
				"command": "alpha.toggleAutoApprove",
				"key": "cmd+alt+a",
				"mac": "cmd+alt+a",
				"win": "ctrl+alt+a",
				"linux": "ctrl+alt+a"
			}
		],
		"configuration": {
			"title": "%configuration.title%",
			"properties": {
				"alpha.allowedCommands": {
					"type": "array",
					"items": {
						"type": "string"
					},
					"default": [],
					"description": "%commands.allowedCommands.description%"
				},
				"alpha.deniedCommands": {
					"type": "array",
					"items": {
						"type": "string"
					},
					"default": [],
					"description": "%commands.deniedCommands.description%"
				},
				"alpha.commandExecutionTimeout": {
					"type": "number",
					"default": 0,
					"minimum": 0,
					"maximum": 600,
					"description": "%commands.commandExecutionTimeout.description%"
				},
				"alpha.commandTimeoutAllowlist": {
					"type": "array",
					"items": {
						"type": "string"
					},
					"default": [],
					"description": "%commands.commandTimeoutAllowlist.description%"
				},
				"alpha.preventCompletionWithOpenTodos": {
					"type": "boolean",
					"default": false,
					"description": "%commands.preventCompletionWithOpenTodos.description%"
				},
				"alpha.completionHooks": {
					"type": "object",
					"scope": "machine",
					"default": {},
					"description": "%settings.completionHooks.description%",
					"properties": {
						"hooks": {
							"type": "object"
						}
					},
					"patternProperties": {
						"^(stop|Stop|subagentStop|SubagentStop|sessionStart|SessionStart|subagentStart|SubagentStart|userPromptSubmit|UserPromptSubmit|preToolUse|PreToolUse|postToolUse|PostToolUse|permissionRequest|PermissionRequest|preModelRequest|PreModelRequest|postModelRequest|PostModelRequest|preCompact|PreCompact|postCompact|PostCompact|interrupt|Interrupt|sessionEnd|SessionEnd)$": {
							"type": "array",
							"maxItems": 8,
							"items": {
								"oneOf": [
									{
										"type": "object",
										"required": [
											"command"
										],
										"additionalProperties": false,
										"properties": {
											"command": {
												"type": "string",
												"minLength": 1
											},
											"commandWindows": {
												"type": "string",
												"minLength": 1
											},
											"args": {
												"type": "array",
												"items": {
													"type": "string"
												}
											},
											"type": {
												"type": "string",
												"enum": [
													"command"
												]
											},
											"async": {
												"type": "boolean"
											},
											"timeoutMs": {
												"type": "integer",
												"minimum": 1,
												"maximum": 2147483647
											},
											"timeout": {
												"type": "integer",
												"minimum": 1,
												"maximum": 2147483
											},
											"matcher": {
												"type": "string",
												"maxLength": 4096
											},
											"additionalContextLimit": {
												"type": "integer",
												"minimum": 0
											}
										}
									},
									{
										"type": "object",
										"required": [
											"type",
											"server",
											"tool"
										],
										"additionalProperties": false,
										"properties": {
											"type": {
												"type": "string",
												"enum": [
													"mcp_tool"
												]
											},
											"server": {
												"type": "string",
												"minLength": 1
											},
											"tool": {
												"type": "string",
												"minLength": 1
											},
											"input": {
												"type": "object"
											},
											"timeoutMs": {
												"type": "integer",
												"minimum": 1,
												"maximum": 2147483647
											},
											"timeout": {
												"type": "integer",
												"minimum": 1,
												"maximum": 2147483
											},
											"matcher": {
												"type": "string",
												"maxLength": 4096
											},
											"additionalContextLimit": {
												"type": "integer",
												"minimum": 0
											}
										}
									},
									{
										"type": "object",
										"required": [
											"hooks"
										],
										"additionalProperties": false,
										"properties": {
											"matcher": {
												"type": "string",
												"maxLength": 4096
											},
											"hooks": {
												"type": "array",
												"maxItems": 8,
												"items": {
													"oneOf": [
														{
															"type": "object",
															"required": [
																"command"
															],
															"additionalProperties": false,
															"properties": {
																"command": {
																	"type": "string",
																	"minLength": 1
																},
																"commandWindows": {
																	"type": "string",
																	"minLength": 1
																},
																"args": {
																	"type": "array",
																	"items": {
																		"type": "string"
																	}
																},
																"type": {
																	"type": "string",
																	"enum": [
																		"command"
																	]
																},
																"async": {
																	"type": "boolean"
																},
																"timeoutMs": {
																	"type": "integer",
																	"minimum": 1,
																	"maximum": 2147483647
																},
																"timeout": {
																	"type": "integer",
																	"minimum": 1,
																	"maximum": 2147483
																},
																"matcher": {
																	"type": "string",
																	"maxLength": 4096
																},
																"additionalContextLimit": {
																	"type": "integer",
																	"minimum": 0
																}
															}
														},
														{
															"type": "object",
															"required": [
																"type",
																"server",
																"tool"
															],
															"additionalProperties": false,
															"properties": {
																"type": {
																	"type": "string",
																	"enum": [
																		"mcp_tool"
																	]
																},
																"server": {
																	"type": "string",
																	"minLength": 1
																},
																"tool": {
																	"type": "string",
																	"minLength": 1
																},
																"input": {
																	"type": "object"
																},
																"timeoutMs": {
																	"type": "integer",
																	"minimum": 1,
																	"maximum": 2147483647
																},
																"timeout": {
																	"type": "integer",
																	"minimum": 1,
																	"maximum": 2147483
																},
																"matcher": {
																	"type": "string",
																	"maxLength": 4096
																},
																"additionalContextLimit": {
																	"type": "integer",
																	"minimum": 0
																}
															}
														}
													]
												}
											}
										}
									}
								]
							}
						}
					},
					"additionalProperties": false
				},
				"alpha.vsCodeLmModelSelector": {
					"type": "object",
					"properties": {
						"vendor": {
							"type": "string",
							"description": "%settings.vsCodeLmModelSelector.vendor.description%"
						},
						"family": {
							"type": "string",
							"description": "%settings.vsCodeLmModelSelector.family.description%"
						},
						"version": {
							"type": "string",
							"description": "%settings.vsCodeLmModelSelector.version.description%"
						},
						"id": {
							"type": "string",
							"description": "%settings.vsCodeLmModelSelector.id.description%"
						}
					},
					"description": "%settings.vsCodeLmModelSelector.description%"
				},
				"alpha.customStoragePath": {
					"type": "string",
					"default": "",
					"description": "%settings.customStoragePath.description%"
				},
				"alpha.autoImportSettingsPath": {
					"type": "string",
					"scope": "machine",
					"default": "",
					"description": "%settings.autoImportSettingsPath.description%"
				},
				"alpha.maximumIndexedFilesForFileSearch": {
					"type": "number",
					"default": 10000,
					"minimum": 5000,
					"maximum": 500000,
					"description": "%settings.maximumIndexedFilesForFileSearch.description%"
				},
				"alpha.useAgentRules": {
					"type": "boolean",
					"default": true,
					"description": "%settings.useAgentRules.description%"
				},
				"alpha.projectRootMarkers": {
					"type": "array",
					"scope": "application",
					"items": {
						"type": "string",
						"minLength": 1,
						"pattern": "^(?!\\.{1,2}$)[^\\\\/\\u0000:]+$"
					},
					"default": [
						".git"
					],
					"description": "%settings.projectRootMarkers.description%"
				},
				"alpha.projectDocFallbackFilenames": {
					"type": "array",
					"scope": "application",
					"items": {
						"type": "string",
						"minLength": 1,
						"pattern": "^(?!\\.{1,2}$)[^\\\\/\\u0000:]+$"
					},
					"default": [],
					"description": "%settings.projectDocFallbackFilenames.description%"
				},
				"alpha.projectDocMaxBytes": {
					"type": "integer",
					"scope": "application",
					"default": 32768,
					"minimum": 0,
					"maximum": 1048576,
					"description": "%settings.projectDocMaxBytes.description%"
				},
				"alpha.apiRequestTimeout": {
					"type": "number",
					"default": 600,
					"minimum": 0,
					"maximum": 3600,
					"description": "%settings.apiRequestTimeout.description%"
				},
				"alpha.newTaskRequireTodos": {
					"type": "boolean",
					"default": false,
					"description": "%settings.newTaskRequireTodos.description%"
				},
				"alpha.codeIndex.embeddingBatchSize": {
					"type": "number",
					"default": 60,
					"minimum": 1,
					"maximum": 200,
					"description": "%settings.codeIndex.embeddingBatchSize.description%"
				},
				"alpha.debug": {
					"type": "boolean",
					"default": false,
					"description": "%settings.debug.description%"
				},
				"alpha.debugProxy.enabled": {
					"type": "boolean",
					"default": false,
					"description": "%settings.debugProxy.enabled.description%",
					"markdownDescription": "%settings.debugProxy.enabled.description%"
				},
				"alpha.debugProxy.serverUrl": {
					"type": "string",
					"default": "http://127.0.0.1:8888",
					"description": "%settings.debugProxy.serverUrl.description%",
					"markdownDescription": "%settings.debugProxy.serverUrl.description%"
				},
				"alpha.debugProxy.tlsInsecure": {
					"type": "boolean",
					"default": false,
					"description": "%settings.debugProxy.tlsInsecure.description%",
					"markdownDescription": "%settings.debugProxy.tlsInsecure.description%",
					"deprecationMessage": "%settings.debugProxy.tlsInsecure.deprecationMessage%"
				}
			}
		}
	},

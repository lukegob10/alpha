{
	"$schema": "https://turbo.build/schema.json",
	"extends": ["//"],
	"tasks": {
		"bundle": {
			"dependsOn": ["^build", "@alpha-code/vscode-webview#build"],
			"inputs": [
				"$TURBO_DEFAULT$",
				"$TURBO_ROOT$/README.md",
				"$TURBO_ROOT$/CHANGELOG.md",
				"$TURBO_ROOT$/LICENSE",
				"$TURBO_ROOT$/scripts/extension-build-provenance.mjs",
				"$TURBO_ROOT$/webview-ui/audio/**"
			],
			"outputs": [
				"dist/**",
				"README.md",
				"CHANGELOG.md",
				"LICENSE",
				"assets/vscode-material-icons/**",
				"webview-ui/audio/**"
			]
		},
		"vsix": {
			"dependsOn": ["bundle"],
			"cache": false
		},
		"watch:bundle": {
			"dependsOn": ["@alpha-code/build#build", "@alpha-code/types#build"],
			"cache": false
		}
	}
}
